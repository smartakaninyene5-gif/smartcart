# Copy to .env and fill values locally. NEVER commit .env.
# All settings use the SMARTCART_ prefix.

# dev | test | sandbox | production
SMARTCART_ENV=dev
SMARTCART_DATABASE_URL=sqlite+pysqlite:///./smartcart.db

# Demo identity header fallback (single-user MVP)
SMARTCART_DEMO_USER_ID=user_demo

# Product source: mock | channel3
SMARTCART_PRODUCT_SOURCE=mock
SMARTCART_CHANNEL3_API_KEY=
SMARTCART_CHANNEL3_BASE_URL=https://api.trychannel3.com
SMARTCART_CHANNEL3_TIMEOUT_SECONDS=20

# AI provider: none | gemini (deterministic core works with none)
SMARTCART_AI_PROVIDER=none
SMARTCART_GEMINI_API_KEY=
SMARTCART_GEMINI_MODEL=gemini-2.5-flash
SMARTCART_GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# PayPal: sandbox | live. Empty credentials disable the payment flow (503).
SMARTCART_PAYPAL_ENV=sandbox
SMARTCART_PAYPAL_CLIENT_ID=
SMARTCART_PAYPAL_CLIENT_SECRET=
SMARTCART_PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
SMARTCART_PAYPAL_RETURN_URL=http://localhost:8000/?paypal=return
SMARTCART_PAYPAL_CANCEL_URL=http://localhost:8000/?paypal=cancel

# Guard defaults (user limits can only tighten these)
SMARTCART_GUARD_POLICY_VERSION=1.0.0
SMARTCART_GUARD_MAX_TOTAL=1000.00
SMARTCART_GUARD_MAX_ITEM=500.00
SMARTCART_GUARD_MAX_QUANTITY=5
SMARTCART_GUARD_MAX_EVIDENCE_AGE_SECONDS=900
